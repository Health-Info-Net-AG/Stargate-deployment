# Secrets directory (contains Vault keys)
secrets/

# .env here is a TRACKED symlink to /var/data/vereign/.env, where the real file
# lives -- without it a bare `docker compose` run from this directory loads no
# env file and falls back to the defaults in docker-compose.yml. Being tracked,
# it is exempt from this entry: if it is ever replaced by a real file, git
# reports a modification. Do not commit that -- it holds credentials.
.env

# Customer-specific config files (contain secrets like Vault tokens and WG keys)
customer-config.sh
customer-config.alpha
customer-config.beta
customer-config.gamma

# Runtime-generated APISIX config (regenerated by apisix-init on each `up`).
# Keep the directory (.gitkeep) but not the generated file.
config/apisix/generated/apisix.yaml

# Per-deployment KERI watcher config (operator copies from watcher.yml.example).
# Holds the watcher's fixed secret seed -- must never be committed.
config/keri/watcher.yml

# update.sh's log (also written by the ops-agent's dashboard-triggered
# update.sh runs). May contain customer-specific details from the update.
update.log

# backup.sh output. Contains Vault unseal keys/root token, KV secrets, and
# the WireGuard private key -- must never be committed.
backups/
